# ---------- AI (pick ONE; leave all empty to use the built-in keyword analyser) ----------
LLM_PROVIDER=            # anthropic | openai | gemini  (auto-detected from whichever key is set)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------- Speech-to-text (runs locally) ----------
# tiny | base | small | medium | large-v3  -> bigger = more accurate but slower
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8

# ---------- App ----------
MAX_UPLOAD_MB=1024
MAX_CONCURRENT_JOBS=1
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
